  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: " Photos taken throughout the events of the Streynian War. \r\n1: Scenes
    from a riot where the police were dispatched. This marks one of the first incidents
    of rising tensions between the people of Streynia.\r\n2: Debate between the then
    Prime Minister (Thebrean) and the opposition party leader running the elections
    against him (Eskani).\r\n3: One of the few incidents of a peaceful protest during
    these times. This protest was heralded by people asking for ceasefires and equal
    rights.\r\n4: An abandoned child holding onto their plush toy as they watch their
    hometown erupting into flames.\r\r\n5: Multiple people boarding planes to escape
    the war-torn nation to seek refuge and safety elsewhere.\r\r"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: d1da5bcef7c015144bc91882c920dd72, type: 2}
  m_sharedMaterial: {fileID: -2874221223040523368, guid: d1da5bcef7c015144bc91882c920dd72, type: 2}
